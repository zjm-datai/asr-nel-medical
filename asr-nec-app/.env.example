APP_NAME=ASR NEC Demo API
API_HOST=127.0.0.1
API_PORT=8016
API_RELOAD=true
ROOT_PATH=
FRONTEND_DIST_DIR=ui/dist
LOG_LEVEL=INFO

RUN_MIGRATIONS=false
APP_MODULE=app:app

DATABASE_URL=sqlite:///storage/app.db
STORAGE_DIR=storage
UPLOAD_DIR=storage/uploads
CORS_ORIGINS=http://127.0.0.1:5009,http://localhost:5009

NEC_SKIP_MODEL_LOAD=false
NEC_DEVICE=
WHISPER_MODEL_PATH=../weights/base.pt
SS_CHECKPOINT_PATH=../runs/ss_full_seed_20260724/best.pt
GL_CHECKPOINT_PATH=../runs/gl_augmented_aligned_e5/best.pt
NEC_DATA_DIR=../data/speech_searcher
NEC_FEATURE_DIR=../data/speech_searcher/ss_features_full
NEC_RUNS_DIR=../runs
EXAMPLES_FILE=data/examples.json
EXAMPLES_AUDIO_DIR=../data/speech_searcher/audio_full
DEFAULT_TOP_K=5
DEFAULT_THRESHOLD=0.3
