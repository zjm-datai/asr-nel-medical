CUDA_BASE_IMAGE=nvidia/cuda:12.4.1-cudnn-devel-ubuntu22.04
PYTHON_VERSION=3.11
PYTORCH_VERSION=2.6.0
MINICONDA_VERSION=py311_25.5.1-1
PYPI_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
SS_IMAGE=asr-nec-model:ss-pilot
SS_CONTAINER_NAME=ss-train
CUDA_VISIBLE_DEVICES=0
WHISPER_MODEL=../weights/base.pt
FEATURE_BATCH_SIZE=16
TRAIN_BATCH_SIZE=32
EVAL_BATCH_SIZE=64
EPOCHS=20
LEARNING_RATE=1e-4
NUM_WORKERS=4
PATIENCE=5
AUTO_RESUME=1
